<?xml version="1.0" encoding="utf-8" ?>


<ContentPage
    xmlns:tool="clr-namespace:Microsoft.Maui.Controls;assembly=Microsoft.Maui.Controls"
     xmlns="http://schemas.microsoft.com/dotnet/2021/maui" 
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" 
             x:Class="ARSoftware.Pages.ChangePasswordPage" 
             BackgroundColor="#0A1931" 
             Shell.NavBarIsVisible="False"
             Shell.FlyoutBehavior="Disabled">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="🏠 Dashboard" Clicked="OnBackToDashboard" Order="Primary" />
    </ContentPage.ToolbarItems>
    <Grid>
        <!-- Ganesh Background -->
        <Image Source="ganesh_mobile_bg.jpg" Aspect="AspectFill" Opacity="0.7" />
        <BoxView BackgroundColor="#0A1931AA" />

        <ScrollView>
            <VerticalStackLayout Spacing="0" Padding="0" VerticalOptions="FillAndExpand">

                <!-- Top Bar - Same as Forgot -->
                <Border BackgroundColor="#0A1931E6" StrokeThickness="0" Padding="16,14">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Label Text="લાભ" FontSize="28" FontAttributes="Bold" TextColor="#FFD700" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="શ્રી ગણેશાય નમઃ" FontSize="22" FontAttributes="Bold" TextColor="#FF8A50" HorizontalOptions="Center" VerticalOptions="Center"/>
                        <Label Grid.Column="2" Text="શુભ" FontSize="28" FontAttributes="Bold" TextColor="#FFD700" VerticalOptions="Center"/>
                    </Grid>
                </Border>

                <!-- AR Logo in White Circle -->
                <Border BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 60" WidthRequest="110" HeightRequest="110" HorizontalOptions="Center" Margin="0,30,0,10" Padding="10">
                    <Image Source="ar_logo.jpg" Aspect="AspectFit" />
                </Border>

                <!-- Change Password Card -->
                <Border BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 20" Padding="22" Margin="20,10,20,20" MaximumWidthRequest="440" HorizontalOptions="Center">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="Change Password" FontSize="18" FontAttributes="Bold" TextColor="#0A1931" HorizontalOptions="Center"/>
                        <Label Text="જૂનો પાસવર્ડ નાખી નવો બનાવો" FontSize="11" TextColor="#888" HorizontalOptions="Center" Margin="0,-6,0,6"/>

                        <!-- Old Password -->
                        <VerticalStackLayout Spacing="5">
                            <Label Text="🔑 Old Password" FontSize="10" FontAttributes="Bold" TextColor="#0A0A0A"/>
                            <Border BackgroundColor="#F9F7F0" Stroke="#D4AF37" StrokeThickness="0.5" StrokeShape="RoundRectangle 12" Padding="12,4">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Entry x:Name="OldPassEntry" Placeholder="જૂનો પાસવર્ડ" IsPassword="True" PlaceholderColor="#AAA" TextColor="#0A0A0A" FontSize="13" BackgroundColor="Transparent"/>
                                    <Label Grid.Column="1" Text="👁️" FontSize="14" VerticalOptions="Center" Padding="8,0">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnToggleOldPassword"/>
                                        </Label.GestureRecognizers>
                                    </Label>
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <!-- New Password -->
                        <VerticalStackLayout Spacing="5">
                            <Label Text="🔒 New Password" FontSize="10" FontAttributes="Bold" TextColor="#0A0A0A"/>
                            <Border BackgroundColor="#F9F7F0" Stroke="#D4AF37" StrokeThickness="0.5" StrokeShape="RoundRectangle 12" Padding="12,4">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Entry x:Name="NewPassEntry" Placeholder="નવો પાસવર્ડ" IsPassword="True" PlaceholderColor="#AAA" TextColor="#0A0A0A" FontSize="13" BackgroundColor="Transparent" TextChanged="OnNewPasswordChanged"/>
                                    <Label Grid.Column="1" Text="👁️" FontSize="14" VerticalOptions="Center" Padding="8,0">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnToggleNewPassword"/>
                                        </Label.GestureRecognizers>
                                    </Label>
                                </Grid>
                            </Border>
                            <Label x:Name="StrengthLabel" Text="Strength: -" FontSize="9" FontAttributes="Bold" TextColor="#888" Margin="4,0,0,0"/>
                        </VerticalStackLayout>

                        <!-- Confirm Password -->
                        <VerticalStackLayout Spacing="5">
                            <Label Text="🔒 Confirm New Password" FontSize="10" FontAttributes="Bold" TextColor="#0A0A0A"/>
                            <Border BackgroundColor="#F9F7F0" Stroke="#D4AF37" StrokeThickness="0.5" StrokeShape="RoundRectangle 12" Padding="12,4">
                                <Entry x:Name="ConfirmPassEntry" Placeholder="કન્ફર્મ કરો" IsPassword="True" PlaceholderColor="#AAA" TextColor="#0A0A0A" FontSize="13" BackgroundColor="Transparent"/>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Update Button -->
                        <Border BackgroundColor="#22C55E" StrokeThickness="0" StrokeShape="RoundRectangle 12" HeightRequest="46" Margin="0,8,0,0">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnUpdatePasswordClicked"/>
                            </Border.GestureRecognizers>
                            <Label Text="✅ Update Password" FontSize="14" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>

                        <Label x:Name="ErrorLabel" Text="" FontSize="10" FontAttributes="Bold" TextColor="#EF4444" IsVisible="False" HorizontalOptions="Center"/>

                        <Label Text="← Back to Settings" FontSize="10" FontAttributes="Bold" TextColor="#8B6914" HorizontalOptions="Center" Margin="0,6,0,0">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnBackClicked"/>
                            </Label.GestureRecognizers>
                        </Label>

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>

