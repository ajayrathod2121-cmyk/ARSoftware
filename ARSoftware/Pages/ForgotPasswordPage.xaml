<?xml version="1.0" encoding="utf-8" ?>


<ContentPage
    xmlns:tool="clr-namespace:Microsoft.Maui.Controls;assembly=Microsoft.Maui.Controls"
     xmlns="http://schemas.microsoft.com/dotnet/2021/maui" 
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" 
             x:Class="ARSoftware.Pages.ForgotPasswordPage" 
             BackgroundColor="#0A1931" 
             Shell.NavBarIsVisible="False" 
             Shell.FlyoutBehavior="Disabled">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="🏠 Dashboard" Clicked="OnBackToDashboard" Order="Primary" />
    </ContentPage.ToolbarItems>
    <Grid>
        <!-- ✅ FIX: ganesh_background.jpg -> ganesh_mobile_bg.jpg -->
        <Image Source="ganesh_mobile_bg.jpg" Aspect="AspectFill" Opacity="0.7" />
        <BoxView BackgroundColor="#0A1931AA" />

        <ScrollView>
            <VerticalStackLayout Spacing="0" Padding="0" VerticalOptions="FillAndExpand">

                <!-- Top Bar -->
                <Border BackgroundColor="#0A1931E6" StrokeThickness="0" Padding="16,14">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Label Text="લાભ" FontSize="28" FontAttributes="Bold" TextColor="#FFD700" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="શ્રી ગણેશાય નમઃ" FontSize="22" FontAttributes="Bold" TextColor="#FF8A50" HorizontalOptions="Center" VerticalOptions="Center"/>
                        <Label Grid.Column="2" Text="શુભ" FontSize="28" FontAttributes="Bold" TextColor="#FFD700" VerticalOptions="Center"/>
                    </Grid>
                </Border>

                <!-- ✅ FIX: ar_logo_clean.png -> ar_logo.jpg + Background White -->
                <Border BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 60" WidthRequest="110" HeightRequest="110" HorizontalOptions="Center" Margin="0,30,0,10" Padding="10">
                    <Image Source="ar_logo.jpg" Aspect="AspectFit" />
                </Border>

                <!-- Step 1: Enter Mobile -->
                <Border x:Name="Step1Border" BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 20" Padding="22" Margin="20,10,20,20" MaximumWidthRequest="440" HorizontalOptions="Center" IsVisible="True">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="Forgot Password?" FontSize="18" FontAttributes="Bold" TextColor="#0A1931" HorizontalOptions="Center"/>
                        <Label Text="Mobile નંબર નાખો, OTP મોકલશું" FontSize="11" TextColor="#888" HorizontalOptions="Center" Margin="0,-6,0,6"/>

                        <VerticalStackLayout Spacing="5">
                            <Label Text="📱 Mobile Number" FontSize="10" FontAttributes="Bold" TextColor="#0A0A0A"/>
                            <Border BackgroundColor="#F9F7F0" Stroke="#D4AF37" StrokeThickness="0.5" StrokeShape="RoundRectangle 12" Padding="12,4">
                                <Entry x:Name="MobileEntry" Placeholder="98765 43210" Keyboard="Numeric" MaxLength="10" PlaceholderColor="#AAA" TextColor="#0A0A0A" FontSize="13" BackgroundColor="Transparent"/>
                            </Border>
                        </VerticalStackLayout>

                        <Border BackgroundColor="#D4AF37" StrokeThickness="0" StrokeShape="RoundRectangle 12" HeightRequest="46" Margin="0,8,0,0">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSendOtpClicked"/>
                            </Border.GestureRecognizers>
                            <Label Text="📤 OTP મોકલો" FontSize="14" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>

                        <Label x:Name="Step1Error" Text="" FontSize="10" FontAttributes="Bold" TextColor="#EF4444" IsVisible="False" HorizontalOptions="Center"/>
                        <Label Text="← Back to Login" FontSize="10" FontAttributes="Bold" TextColor="#8B6914" HorizontalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnBackToLoginClicked"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </VerticalStackLayout>
                </Border>

                <!-- Step 2: Enter OTP -->
                <Border x:Name="Step2Border" BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 20" Padding="22" Margin="20,10,20,20" MaximumWidthRequest="440" HorizontalOptions="Center" IsVisible="False">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="OTP Verify કરો" FontSize="18" FontAttributes="Bold" TextColor="#0A1931" HorizontalOptions="Center"/>
                        <Label x:Name="OtpSentLabel" Text="OTP મોકલ્યો છે 98XXXXXX10 પર" FontSize="11" TextColor="#888" HorizontalOptions="Center" Margin="0,-6,0,6"/>

                        <VerticalStackLayout Spacing="5">
                            <Label Text="🔢 4 Digit OTP" FontSize="10" FontAttributes="Bold" TextColor="#0A0A0A"/>
                            <Border BackgroundColor="#F9F7F0" Stroke="#D4AF37" StrokeThickness="0.5" StrokeShape="RoundRectangle 12" Padding="12,4">
                                <Entry x:Name="OtpEntry" Placeholder="1234" Keyboard="Numeric" MaxLength="4" PlaceholderColor="#AAA" TextColor="#0A0A0A" FontSize="18" FontAttributes="Bold" HorizontalTextAlignment="Center" BackgroundColor="Transparent"/>
                            </Border>
                            <Label x:Name="TimerLabel" Text="⏱ 02:00" FontSize="9" TextColor="#FF6B00" HorizontalOptions="Center"/>
                        </VerticalStackLayout>

                        <Border BackgroundColor="#0A1931" StrokeThickness="0" StrokeShape="RoundRectangle 12" HeightRequest="46" Margin="0,8,0,0">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnVerifyOtpClicked"/>
                            </Border.GestureRecognizers>
                            <Label Text="✅ OTP Verify કરો" FontSize="14" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>

                        <Grid ColumnDefinitions="*,*">
                            <Label Text="🔄 Resend OTP" FontSize="10" FontAttributes="Bold" TextColor="#D4AF37" HorizontalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnResendOtpClicked"/>
                                </Label.GestureRecognizers>
                            </Label>
                            <Label Grid.Column="1" Text="← Back" FontSize="10" FontAttributes="Bold" TextColor="#666" HorizontalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnBackToStep1Clicked"/>
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>

                        <Label x:Name="Step2Error" Text="" FontSize="10" FontAttributes="Bold" TextColor="#EF4444" IsVisible="False" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Step 3: New Password -->
                <Border x:Name="Step3Border" BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 20" Padding="22" Margin="20,10,20,20" MaximumWidthRequest="440" HorizontalOptions="Center" IsVisible="False">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="New Password બનાવો" FontSize="18" FontAttributes="Bold" TextColor="#0A1931" HorizontalOptions="Center"/>
                        <Label Text="નવો પાસવર્ડ નાખો" FontSize="11" TextColor="#888" HorizontalOptions="Center" Margin="0,-6,0,6"/>

                        <VerticalStackLayout Spacing="5">
                            <Label Text="🔒 New Password" FontSize="10" FontAttributes="Bold" TextColor="#0A0A0A"/>
                            <Border BackgroundColor="#F9F7F0" Stroke="#D4AF37" StrokeThickness="0.5" StrokeShape="RoundRectangle 12" Padding="12,4">
                                <Entry x:Name="NewPassEntry" Placeholder="નવો પાસવર્ડ" IsPassword="True" PlaceholderColor="#AAA" TextColor="#0A0A0A" FontSize="13" BackgroundColor="Transparent"/>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="5">
                            <Label Text="🔒 Confirm Password" FontSize="10" FontAttributes="Bold" TextColor="#0A0A0A"/>
                            <Border BackgroundColor="#F9F7F0" Stroke="#D4AF37" StrokeThickness="0.5" StrokeShape="RoundRectangle 12" Padding="12,4">
                                <Entry x:Name="ConfirmPassEntry" Placeholder="પાસવર્ડ કન્ફર્મ કરો" IsPassword="True" PlaceholderColor="#AAA" TextColor="#0A0A0A" FontSize="13" BackgroundColor="Transparent"/>
                            </Border>
                        </VerticalStackLayout>

                        <Border BackgroundColor="#22C55E" StrokeThickness="0" StrokeShape="RoundRectangle 12" HeightRequest="46" Margin="0,8,0,0">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnChangePasswordClicked"/>
                            </Border.GestureRecognizers>
                            <Label Text="🔑 Password Change કરો" FontSize="14" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>

                        <Label x:Name="Step3Error" Text="" FontSize="10" FontAttributes="Bold" TextColor="#EF4444" IsVisible="False" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>

