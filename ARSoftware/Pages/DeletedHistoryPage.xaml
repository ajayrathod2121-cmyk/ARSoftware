<?xml version="1.0" encoding="utf-8" ?>


<ContentPage
    xmlns:tool="clr-namespace:Microsoft.Maui.Controls;assembly=Microsoft.Maui.Controls"
     xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ARSoftware.Pages.DeletedHistoryPage"
             Title="Deleted History"
             BackgroundColor="#FAFAFA">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="🏠 Dashboard" Clicked="OnBackToDashboard" Order="Primary" />
    </ContentPage.ToolbarItems>

    <VerticalStackLayout Padding="15" Spacing="12">

        <Border BackgroundColor="#0A0A0A" StrokeThickness="0" StrokeShape="RoundRectangle 16" Padding="16">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <Label Text="🗑️" FontSize="22" VerticalOptions="Center"/>
                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                    <Label Text="Deleted History - Recycle Bin" FontSize="14" FontAttributes="Bold" TextColor="White"/>
                    <Label Text="Delete થયેલો Data અહીંથી પાછો લાવી શકાય" FontSize="10" TextColor="#AAAAAA"/>
                </VerticalStackLayout>
                <Button Grid.Column="2" Text="Clear All" BackgroundColor="#FF3B30" TextColor="White" CornerRadius="8" FontSize="10" Clicked="OnClearAllClicked"/>
            </Grid>
        </Border>

        <CollectionView x:Name="HistoryList" EmptyView="કોઈ Delete થયેલો Data નથી">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border BackgroundColor="White" Stroke="#F0F0F0" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="12" Margin="0,6">
                        <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10">

                            <Border Grid.RowSpan="3" BackgroundColor="#FFE5E5" StrokeThickness="0" StrokeShape="RoundRectangle 8" WidthRequest="40" HeightRequest="40" VerticalOptions="Center">
                                <Label Text="🗑️" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>

                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="6">
                                    <Border BackgroundColor="#0A0A0A" StrokeThickness="0" StrokeShape="RoundRectangle 4" Padding="6,2">
                                        <Label Text="{Binding TableName}" FontSize="8" FontAttributes="Bold" TextColor="White"/>
                                    </Border>
                                    <Label Grid.Column="1" Text="{Binding DisplayName}" FontSize="11" FontAttributes="Bold" TextColor="#0A0A0A" VerticalOptions="Center"/>
                                </Grid>

                                <Label Text="{Binding DeletedAt, StringFormat='Delete: {0:dd-MM-yyyy HH:mm}'}" FontSize="9" TextColor="Gray"/>

                                <Label Text="{Binding DataJson}" FontSize="8" TextColor="#666" LineBreakMode="TailTruncation" MaxLines="2"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="2" Spacing="6" VerticalOptions="Center">
                                <Button Text="♻️ Restore" BackgroundColor="#10B981" TextColor="White" CornerRadius="8" FontSize="9" Padding="8,4" Clicked="OnRestoreClicked" CommandParameter="{Binding Id}"/>
                                <Button Text="❌" BackgroundColor="#FFE5E5" TextColor="#FF3B30" CornerRadius="8" FontSize="9" Padding="8,4" Clicked="OnPermanentDeleteClicked" CommandParameter="{Binding Id}"/>
                            </VerticalStackLayout>

                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </VerticalStackLayout>
</ContentPage>

