<?xml version="1.0" encoding="utf-8" ?>


<ContentPage
    xmlns:tool="clr-namespace:Microsoft.Maui.Controls;assembly=Microsoft.Maui.Controls"
     xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="ARSoftware.Pages.PartyMasterPage" Title="Party Master" BackgroundColor="#F8F8F7" Shell.NavBarIsVisible="False">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="🏠 Dashboard" Clicked="OnBackToDashboard" Order="Primary" />
    </ContentPage.ToolbarItems>
    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <Border Grid.Row="0" BackgroundColor="#0A0A0A" StrokeThickness="0" HeightRequest="56">
            <Grid ColumnDefinitions="*,Auto" Padding="14,0">
                <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                    <Border BackgroundColor="#1A1A1A" StrokeThickness="0" StrokeShape="RoundRectangle 8" WidthRequest="32" HeightRequest="32">
                        <Label Text="P" FontAttributes="Bold" TextColor="#FF6B00" FontSize="14" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Spacing="0">
                        <Label Text="Party Master" FontAttributes="Bold" TextColor="White" FontSize="14" />
                        <Label Text="Baki + Call + WhatsApp Premium" FontSize="9" TextColor="#AAAAAA" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>
                <Border Grid.Column="1" BackgroundColor="#FF6B00" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="14,8" VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnAddPartyClicked" />
                    </Border.GestureRecognizers>
                    <Label Text="+ Add Party" FontSize="11" FontAttributes="Bold" TextColor="White" />
                </Border>
            </Grid>
        </Border>
        <Border Grid.Row="1" BackgroundColor="White" Stroke="#00000008" StrokeShape="RoundRectangle 14" Margin="12,10,12,0" Padding="12,0">
            <Entry x:Name="SearchEntry" Placeholder="Search Party - Bhavnagr, Mahuva" FontSize="12" TextChanged="OnSearchTextChanged" />
        </Border>
        <CollectionView Grid.Row="2" x:Name="PartyCollection" Margin="12,10">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border BackgroundColor="White" Stroke="#00000006" StrokeShape="RoundRectangle 16" Padding="12" Margin="0,6">
                        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding Name}" FontSize="13" FontAttributes="Bold" TextColor="#0A0A0A" />
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="{Binding Mobile}" FontSize="10" TextColor="#666" />
                                    <Label Text="•" FontSize="10" TextColor="#CCC" />
                                    <Label Text="{Binding City}" FontSize="10" TextColor="#666" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="{Binding Baki, StringFormat='Rs {0:N0}'}" FontSize="11" FontAttributes="Bold" TextColor="#FF6B00" VerticalOptions="Center" />

                            <!-- ✅ COMPACT SQUARE PREMIUM BUTTONS - 32x32 -->
                            <HorizontalStackLayout Grid.Row="1" Grid.ColumnSpan="2" Spacing="6" Margin="0,10,0,0">
                                <Border BackgroundColor="#0A0A0A" StrokeThickness="0" StrokeShape="RoundRectangle 8" WidthRequest="32" HeightRequest="32">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnCallClicked" CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="📞" FontSize="13" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <Border BackgroundColor="#25D366" StrokeThickness="0" StrokeShape="RoundRectangle 8" WidthRequest="32" HeightRequest="32">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnWhatsappClicked" CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="💬" FontSize="13" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <Border BackgroundColor="#F0F0F0" StrokeThickness="0" StrokeShape="RoundRectangle 8" WidthRequest="32" HeightRequest="32">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnEditPartyClicked" CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="✏️" FontSize="11" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <Border BackgroundColor="#FFE0E0" StrokeThickness="0" StrokeShape="RoundRectangle 8" WidthRequest="32" HeightRequest="32">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnDeletePartyClicked" CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="🗑️" FontSize="11" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <BoxView WidthRequest="1" Color="#EEE" Margin="2,0"/>
                                <Border BackgroundColor="#FFF7ED" Stroke="#FF6B00" StrokeThickness="0.8" StrokeShape="RoundRectangle 8" WidthRequest="32" HeightRequest="32">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnHistoryClicked" CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="📊" FontSize="11" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <Border BackgroundColor="#E3F2FD" StrokeThickness="0" StrokeShape="RoundRectangle 8" WidthRequest="32" HeightRequest="32">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnPaymentClicked" CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="💰" FontSize="11" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                            </HorizontalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <Border Grid.Row="3" BackgroundColor="#0A0A0A" StrokeThickness="0" StrokeShape="RoundRectangle 18" Margin="12" Padding="14">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnPrintPdfClicked" />
            </Border.GestureRecognizers>
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="Print Party List PDF - Premium" FontSize="11" FontAttributes="Bold" TextColor="White" VerticalOptions="Center" />
                <Border Grid.Column="1" BackgroundColor="#FF6B00" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="14,8">
                    <Label Text="Print PDF" FontSize="10" FontAttributes="Bold" TextColor="White" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</ContentPage>

