<?xml version="1.0" encoding="utf-8" ?>


<ContentPage
    xmlns:tool="clr-namespace:Microsoft.Maui.Controls;assembly=Microsoft.Maui.Controls"
     xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ARSoftware.Pages.ExpensePage"
             Title="Expenses"
             BackgroundColor="#F8F8F7"
             Shell.NavBarIsVisible="False">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="🏠 Dashboard" Clicked="OnBackToDashboard" Order="Primary" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*,Auto" Padding="0">
        <!-- HEADER -->
        <Border Grid.Row="0" BackgroundColor="#0A0A0A" StrokeThickness="0" Padding="16,12">
            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout Spacing="2">
                    <Label Text="EXPENSES - KHARCHO" FontSize="14" FontAttributes="Bold" TextColor="White"/>
                    <Label x:Name="TotalLabel" Text="Rs 0" FontSize="16" FontAttributes="Bold" TextColor="#FF6B00"/>
                </VerticalStackLayout>
                <Border Grid.Column="1" BackgroundColor="#FF6B00" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="14,8" VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnAddExpenseClicked"/>
                    </Border.GestureRecognizers>
                    <Label Text="+ Add Kharcho" FontSize="12" FontAttributes="Bold" TextColor="White"/>
                </Border>
            </Grid>
        </Border>

        <CollectionView Grid.Row="1" x:Name="ExpenseCollection" Margin="12">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border BackgroundColor="White" Stroke="#E0E0E0" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="12" Margin="0,6">
                        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                            <Label Text="{Binding Title}" FontSize="13" FontAttributes="Bold" TextColor="#0A0A0A"/>
                            <Label Grid.Column="1" Text="{Binding Amount, StringFormat='Rs {0:N0}'}" FontSize="13" FontAttributes="Bold" TextColor="#FF6B00"/>

                            <HorizontalStackLayout Grid.Row="1" Spacing="6" Margin="0,4,0,0">
                                <Border BackgroundColor="#0A0A0A" StrokeThickness="0" StrokeShape="RoundRectangle 6" Padding="8,2">
                                    <Label Text="{Binding Category}" FontSize="9" TextColor="White"/>
                                </Border>
                                <Label Text="{Binding ExpenseDate, StringFormat='{0:dd MMM yyyy}'}" FontSize="10" TextColor="#888" VerticalOptions="Center"/>
                            </HorizontalStackLayout>

                            <!-- ✅ COMPACT SQUARE 32x32 -->
                            <HorizontalStackLayout Grid.Row="2" Spacing="6" Margin="0,10,0,0">
                                <Border BackgroundColor="#F0F0F0" StrokeThickness="0" StrokeShape="RoundRectangle 8" WidthRequest="32" HeightRequest="32">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnEditExpenseClicked" CommandParameter="{Binding .}"/>
                                    </Border.GestureRecognizers>
                                    <Label Text="✏️" FontSize="11" HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                                <Border BackgroundColor="#FFE0E0" StrokeThickness="0" StrokeShape="RoundRectangle 8" WidthRequest="32" HeightRequest="32">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnDeleteExpenseClicked" CommandParameter="{Binding .}"/>
                                    </Border.GestureRecognizers>
                                    <Label Text="🗑️" FontSize="11" HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                                <Label Text="{Binding Remark}" FontSize="10" TextColor="#888" VerticalOptions="Center" MaxLines="1" LineBreakMode="TailTruncation" Margin="6,0,0,0"/>
                            </HorizontalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- FOOTER PDF -->
        <Border Grid.Row="2" BackgroundColor="#0A0A0A" StrokeThickness="0" StrokeShape="RoundRectangle 14" Margin="12" Padding="14">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnPrintExpenseClicked"/>
            </Border.GestureRecognizers>
            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout Spacing="2">
                    <Label Text="Print Expense PDF" FontSize="12" FontAttributes="Bold" TextColor="White"/>
                    <Label Text="White Black Orange Premium Report" FontSize="9" TextColor="#AAAAAA"/>
                </VerticalStackLayout>
                <Border Grid.Column="1" BackgroundColor="#FF6B00" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="14,8">
                    <Label Text="Print PDF" FontSize="11" FontAttributes="Bold" TextColor="White"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</ContentPage>

